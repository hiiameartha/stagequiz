# Socket（方案 B 拆分部署／本機拆分）
# NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
# CORS_ORIGIN=http://localhost:3000

# Postgres（可選；未設定則純記憶體，重啟後房間消失）
# Railway／Neon／Supabase 連線字串皆可
# DATABASE_URL=postgres://user:pass@host:5432/stagequiz

# Postgres — Supabase 建議：
# 1) Dashboard → Connect → 複製 URI
# 2) db:push 用 Direct 或 Session pooler（port 5432）
# 3) 長連線 realtime 也可用同一條，或 Transaction pooler（6543，需 prepare:false，本專案已設）
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
