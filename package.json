{
  "name": "stagequiz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:web": "next dev",
    "dev:split": "concurrently -k -n web,rt -c cyan,magenta \"next dev\" \"tsx watch server/realtime.ts\"",
    "realtime": "tsx server/realtime.ts",
    "build": "next build",
    "build:realtime": "esbuild server/realtime.ts --bundle --platform=node --target=node20 --outfile=dist/realtime.cjs --format=cjs",
    "start": "NODE_ENV=production tsx server/index.ts",
    "start:realtime": "NODE_ENV=production node dist/realtime.cjs",
    "db:push": "drizzle-kit push",
    "lint": "eslint"
  },
  "dependencies": {
    "dotenv": "^18.0.1",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.25.0",
    "next": "16.3.5",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.14",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
